<Window x:Class="ManosabaUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KuiLunUPDater"
        Width="960"
        Height="720"
        MinWidth="780"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="128"/>
        </Style>
        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="KuiLunUPDater"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="启动游戏前检查并修复 Manosaba Modpack"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedText}"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#10251A"
                    BorderBrush="#256D3D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,8"
                    VerticalAlignment="Top">
                <TextBlock x:Name="PackVersionText"
                           Text="等待检查"
                           Foreground="{StaticResource Accent}"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="游戏目录" Style="{StaticResource CaptionText}"/>
                        <TextBox x:Name="GameDirectoryTextBox"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <Button x:Name="ChooseDirectoryButton"
                            Grid.Column="1"
                            Content="选择目录"
                            VerticalAlignment="Bottom"
                            Click="ChooseDirectoryButton_Click"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Manifest URL" Style="{StaticResource CaptionText}"/>
                        <TextBox x:Name="ManifestUrlTextBox"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <Button x:Name="SaveButton"
                            Grid.Column="1"
                            Content="保存"
                            VerticalAlignment="Bottom"
                            Click="SaveButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="请选择游戏目录，然后点击检查并更新。"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentFileText"
                                   Text="当前文件：-"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="PercentText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               Margin="24,0,0,0"
                               VerticalAlignment="Top"/>
                </Grid>

                <ProgressBar x:Name="DownloadProgressBar"
                             Grid.Row="2"
                             Height="10"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Foreground="{StaticResource Accent}"
                             Background="#0B1018"/>

                <UniformGrid Grid.Row="4"
                             Columns="4">
                    <Border Background="#101827" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="剩余文件" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="RemainingFilesText" Text="-" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#101827" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="已下载" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="DownloadedText" Text="-" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#101827" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="剩余大小" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="RemainingSizeText" Text="-" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#101827" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="下载速度" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="SpeedText" Text="-" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Expander x:Name="DetailsExpander"
                          Grid.Row="6"
                          Header="展开详情"
                          Foreground="{StaticResource MutedText}"
                          Visibility="Collapsed">
                    <TextBox x:Name="DetailsTextBox"
                             Margin="0,10,0,0"
                             Height="150"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Expander>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText"
                       Text="配置会保存在 %APPDATA%\ManosabaUpdater\settings.json"
                       Foreground="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="OpenModsButton"
                        Content="打开 mods"
                        Style="{StaticResource SubtleButton}"
                        Click="OpenModsButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource SubtleButton}"
                        IsEnabled="False"
                        Click="CancelButton_Click"/>
                <Button x:Name="CheckAndUpdateButton"
                        Content="检查并更新"
                        Style="{StaticResource PrimaryButton}"
                        Click="CheckAndUpdateButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
