<Window x:Class="ManosabaUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:ManosabaUpdater.UI"
        Title="KuiLunUPDater"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="Transparent">
        <Border x:Name="WindowShell"
                Margin="14"
                Background="{DynamicResource ShellBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="26"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32"
                                  Direction="270"
                                  Opacity="0.34"
                                  ShadowDepth="12"
                                  Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="11"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource CardSoftBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="KuiLunUPDater"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Manosaba Modpack Sync"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                BorderBrush="{DynamicResource CardSoftBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="12,6"
                                Margin="0,0,12,0">
                            <TextBlock x:Name="PackVersionText"
                                       Text="等待检查"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock x:Name="ThemeNameText"
                                       Text="亮色"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ToggleButton x:Name="ThemeToggleButton"
                                          Style="{StaticResource ToggleSwitch}"
                                          ToolTip="切换明暗主题"
                                          AutomationProperties.Name="切换明暗主题"
                                          Checked="ThemeToggleButton_Checked"
                                          Unchecked="ThemeToggleButton_Unchecked"/>
                        </StackPanel>
                        <Button Content="&#xE921;"
                                Style="{StaticResource WindowCaptionButton}"
                                ToolTip="最小化"
                                AutomationProperties.Name="最小化窗口"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton"
                                Content="&#xE922;"
                                Style="{StaticResource WindowCaptionButton}"
                                ToolTip="最大化"
                                AutomationProperties.Name="最大化或还原窗口"
                                Click="MaximizeButton_Click"/>
                        <Button Content="&#xE8BB;"
                                Style="{StaticResource WindowCaptionButton}"
                                ToolTip="关闭"
                                AutomationProperties.Name="关闭窗口"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="244"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource CardSoftBorderBrush}"
                            BorderThickness="0,1,1,0"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="更新流程"
                                           Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="先检查，再下载，最后启动游戏。"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <RadioButton x:Name="NavOverviewButton"
                                             GroupName="Pages"
                                             Tag="Overview"
                                             Style="{StaticResource NavigationRadioButton}"
                                             Checked="NavigationButton_Checked">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="总览"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="NavSettingsButton"
                                             GroupName="Pages"
                                             Tag="Settings"
                                             Style="{StaticResource NavigationRadioButton}"
                                             Checked="NavigationButton_Checked">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="配置"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="NavDetailsButton"
                                             GroupName="Pages"
                                             Tag="Details"
                                             Style="{StaticResource NavigationRadioButton}"
                                             Checked="NavigationButton_Checked">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8A5;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="详情"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </RadioButton>
                            </StackPanel>

                            <Border Grid.Row="3"
                                    Background="{DynamicResource SurfaceSubtleBrush}"
                                    BorderBrush="{DynamicResource CardSoftBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="设置文件"
                                               Style="{StaticResource MonoCaptionText}"/>
                                    <TextBlock x:Name="FooterText"
                                               Text="%APPDATA%\ManosabaUpdater\settings.json"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1"
                          Margin="24,18,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="整合包更新控制台"
                                           FontSize="28"
                                           FontWeight="Bold"/>
                                <TextBlock Text="校验本地 mods，下载缺失或 SHA-256 不一致的文件。"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource InfoSoftBrush}"
                                    BorderBrush="{DynamicResource CardSoftBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="14,9"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{DynamicResource InfoBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="启动游戏前运行"
                                               Foreground="{DynamicResource InfoBrush}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="PageHost"
                              Grid.Row="2">
                            <Grid x:Name="OverviewPage">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              ui:SmoothScrollViewer.IsEnabled="True">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="190"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="当前状态"
                                                               Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="StatusText"
                                                               Text="请选择游戏目录，然后点击检查并更新。"
                                                               FontSize="20"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               LineHeight="29"/>
                                                    <TextBlock x:Name="CurrentFileText"
                                                               Text="当前文件：-"
                                                               Margin="0,12,0,0"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,22,0,0">
                                                        <Button x:Name="CheckAndUpdateButton"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Click="CheckAndUpdateButton_Click"
                                                                AutomationProperties.Name="检查并更新">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE72C;"
                                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           Margin="0,0,8,0"/>
                                                                <TextBlock Text="检查并更新"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="CancelButton"
                                                                Content="取消"
                                                                Style="{StaticResource SubtleButton}"
                                                                Margin="10,0,0,0"
                                                                IsEnabled="False"
                                                                Click="CancelButton_Click"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Width="164"
                                                        Height="164"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSubtleBrush}"
                                                        BorderBrush="{DynamicResource CardSoftBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="82">
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock x:Name="PercentText"
                                                                   Text="0%"
                                                                   FontSize="34"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="完成度"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Card}"
                                                Margin="0,16,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="下载进度"
                                                               Style="{StaticResource CaptionText}"
                                                               Margin="0"/>
                                                    <Border x:Name="BusyPill"
                                                            Grid.Column="1"
                                                            Visibility="Collapsed"
                                                            Background="{DynamicResource WarningSoftBrush}"
                                                            CornerRadius="12"
                                                            Padding="10,4">
                                                        <TextBlock Text="正在处理"
                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <ProgressBar x:Name="DownloadProgressBar"
                                                             Margin="0,14,0,0"
                                                             Height="12"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="0"
                                                             ui:AnimatedProgress.IsEnabled="True"/>
                                            </StackPanel>
                                        </Border>

                                        <UniformGrid Columns="4"
                                                     Margin="0,16,0,0">
                                            <Border Style="{StaticResource MetricCard}"
                                                    Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="剩余文件" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="RemainingFilesText" Text="-" FontSize="20" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}"
                                                    Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="已下载" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="DownloadedText" Text="-" FontSize="20" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}"
                                                    Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="剩余大小" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="RemainingSizeText" Text="-" FontSize="20" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}">
                                                <StackPanel>
                                                    <TextBlock Text="下载速度" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="SpeedText" Text="-" FontSize="20" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="SettingsPage"
                                  Visibility="Collapsed"
                                  Opacity="0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              ui:SmoothScrollViewer.IsEnabled="True">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="游戏目录"
                                                           Style="{StaticResource CaptionText}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="GameDirectoryTextBox"
                                                             TextWrapping="NoWrap"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             AutomationProperties.Name="游戏目录"/>
                                                    <Button x:Name="ChooseDirectoryButton"
                                                            Grid.Column="1"
                                                            Style="{StaticResource SubtleButton}"
                                                            Margin="10,0,0,0"
                                                            Click="ChooseDirectoryButton_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8B7;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock Text="选择目录"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <TextBlock Text="Manifest URL"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,20,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ManifestUrlTextBox"
                                                             TextWrapping="NoWrap"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             AutomationProperties.Name="Manifest URL"/>
                                                    <Button x:Name="SaveButton"
                                                            Grid.Column="1"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Margin="10,0,0,0"
                                                            Click="SaveButton_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74E;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock Text="保存"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}"
                                                Margin="0,16,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="本地 mods 文件夹"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="快速打开当前游戏目录下的 mods 文件夹。"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="OpenModsButton"
                                                        Grid.Column="1"
                                                        Style="{StaticResource SubtleButton}"
                                                        Click="OpenModsButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   Margin="0,0,8,0"/>
                                                        <TextBlock Text="打开 mods"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="DetailsPage"
                                  Visibility="Collapsed"
                                  Opacity="0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="运行详情"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="失败时会自动展开完整异常；平时可用于查看保存和更新记录。"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,6,0,18"
                                                   TextWrapping="Wrap"/>
                                        <Expander x:Name="DetailsExpander"
                                                  Header="诊断日志"
                                                  Visibility="Collapsed">
                                            <TextBox x:Name="DetailsTextBox"
                                                     Height="300"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     FontFamily="{DynamicResource MonoFontFamily}"
                                                     FontSize="12"/>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="BusyOverlay"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,34,34"
                Padding="14,10"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="Collapsed"
                Opacity="0"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Grid Width="22"
                      Height="22"
                      RenderTransformOrigin="0.5,0.5"
                      Margin="0,0,10,0">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="BusySpinnerRotate" Angle="0"/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="BusySpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Ellipse Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="3"
                             StrokeDashArray="2 4"/>
                </Grid>
                <TextBlock Text="正在同步"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="ToastHost"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,82,34,0"
                Width="320"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14"
                Visibility="Collapsed"
                Opacity="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ToastAccentBar"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="2"/>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="ToastTitleText"
                               Text="提示"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ToastMessageText"
                               Text="操作完成。"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
