<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="AppBackdropBrush" Color="#0C1117"/>
    <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16202A" Offset="0"/>
        <GradientStop Color="#101721" Offset="0.54"/>
        <GradientStop Color="#0E131A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBrush" Color="#121A24"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#182230"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#202B3A"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#111925"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#253143"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#314055"/>
    <SolidColorBrush x:Key="CardSoftBorderBrush" Color="#243245"/>

    <SolidColorBrush x:Key="BodyTextBrush" Color="#EEF4F8"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA8B8"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#758498"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#081015"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#5DE2B5"/>
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#22C78B"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#183D35"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#102B27"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#8BA7FF"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1A2445"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F6C96F"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2C17"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7B8A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1C25"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#101823"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#1B2634"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#243248"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#1A2230"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D141E"/>
    <SolidColorBrush x:Key="InputFocusBrush" Color="#152134"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#A60A1018"/>
    <SolidColorBrush x:Key="ShadowColorBrush" Color="#000000"/>
</ResourceDictionary>
