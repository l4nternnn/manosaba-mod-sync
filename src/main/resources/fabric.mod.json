{
	"schemaVersion": 1,
	"id": "manosaba_mod_sync",
	"version": "${version}",
	"name": "Manosaba Mod Sync",
	"description": "Synchronizes a Fabric client mod pack against a server-provided SHA-256 manifest.",
	"authors": [
		"Lantern"
	],
	"contact": {
		"homepage": "https://fabricmc.net/"
	},
	"license": "MIT",
	"icon": "assets/manosaba_mod_sync/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.lantern.manosabamodsync.ManosabaModSync"
		],
		"client": [
			"com.lantern.manosabamodsync.client.ManosabaModSyncClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.3",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modernui": ">=3.12.0",
		"forgeconfigapiport": ">=21.8.2"
